# ======================================
# Inventario stack - ejemplo de variables
# Copia este archivo a ".env" y completa.
# ======================================

# --- Imágenes publicadas en GHCR ---
# Backend publica desde repo backend (.github/workflows/docker-publish.yml)
BACKEND_IMAGE=ghcr.io/<owner>/inventario-backend
BACKEND_TAG=main

# Frontend publica desde repo frontend (.github/workflows/docker-publish.yml)
FRONTEND_IMAGE=ghcr.io/<owner>/inventario-frontend
FRONTEND_TAG=main

# --- Vault (modo dev, para laboratorio) ---
# En prod real se recomienda Vault no-dev (storage + unseal + políticas).
VAULT_DEV_ROOT_TOKEN_ID=change-me-dev-root-token
VAULT_TOKEN=change-me-dev-root-token

# --- Secretos que vault-init escribe en secret/inventario ---
# spring.datasource.password (inyectado por Vault en backend)
SPRING_DATASOURCE_PASSWORD=change-me-db-password

# app.security.secret-key: AES 16, 24 o 32 chars
APP_SECURITY_SECRET_KEY=0123456789abcdef

# jwt.secret-key: minimo 32 chars
JWT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Base de datos local (servicio mariadb-local) ---
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb-local:3306/inventariodb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=inventario

# --- Base de datos externa (opcional) ---
# Si usas DB externa, reemplaza los valores de arriba.
# SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb.interna.local:3306/inventario?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=inventario

# --- Grafana (opcional) ---
# Si usas admin por entorno.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin
